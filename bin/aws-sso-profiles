#!/usr/bin/env bash
#
# Create ~/.aws/config profiles for AWS SSO accounts/roles under an existing
# sso-session, named <prefix>-<account-slug>-<role-alias>.
#
#   aws-sso-profiles                 # pick accounts from a menu
#   aws-sso-profiles -a              # every account/role you have access to
#   aws-sso-profiles sandbox prod     # by account name (or id), non-interactive
#   aws-sso-profiles -n -a           # dry run: show what would be written
#
# Defaults come from flags, then env vars, then the config itself — nothing
# site-specific is built in:
#
#   AWS_SSO_SESSION         sso-session to use (else: the only one in the config)
#   AWS_SSO_PREFIX          profile name prefix (else: the session name)
#   AWS_SSO_PROFILE_REGION  region for new profiles (else: [default] region,
#                           else the sso-session's sso_region)
#   AWS_SSO_ALIAS_FILE      if set (or -A), write a shell file there with an
#                           aws_use function and one alias per SSO profile:
#
#     alias aws-credentials-<profile>='aws_use <profile>'
#
# aws_use runs aws-sso (next to this script) and exports AWS_PROFILE only —
# no access keys ever land in the environment. Source the file from your rc.
#
set -euo pipefail

SESSION=${AWS_SSO_SESSION:-}
PREFIX=${AWS_SSO_PREFIX-}
PREFIX_SET=${AWS_SSO_PREFIX+1}
REGION=${AWS_SSO_PROFILE_REGION:-}
OUTPUT=json
ROLE_FILTER=
ALIAS_FILE=${AWS_SSO_ALIAS_FILE:-}
ALL=0
DRYRUN=0
FORCE=0

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*" >&2; }

usage() {
  cat >&2 <<USAGE
usage: ${0##*/} [-s session] [-p prefix] [-g region] [-o output] [-r role]
       [-A alias-file] [-a] [-n] [-f] [account ...]

  -s session  sso-session in ~/.aws/config     (env AWS_SSO_SESSION; default: the only one)
  -p prefix   profile name prefix, '' for none (env AWS_SSO_PREFIX; default: session name)
  -g region   region for the created profiles  (env AWS_SSO_PROFILE_REGION;
              default: [default] region, else the sso_region)
  -o output   output format for the created profiles (default: $OUTPUT)
  -r role     only this role name, e.g. AdministratorAccess
  -A file     regenerate the shell alias file  (env AWS_SSO_ALIAS_FILE; default: none)
  -a          all accounts/roles, no prompt
  -n          dry run, print the profiles instead of writing them
  -f          overwrite profiles that already exist
  account ... account names (case-insensitive, or slugs) or 12-digit ids
USAGE
  exit 2
}

while getopts ':s:p:g:o:r:A:anfh' opt; do
  case $opt in
    s) SESSION=$OPTARG ;;
    p) PREFIX=$OPTARG; PREFIX_SET=1 ;;
    A) ALIAS_FILE=$OPTARG ;;
    g) REGION=$OPTARG ;;
    o) OUTPUT=$OPTARG ;;
    r) ROLE_FILTER=$OPTARG ;;
    a) ALL=1 ;;
    n) DRYRUN=1 ;;
    f) FORCE=1 ;;
    h|*) usage ;;
  esac
done
shift $((OPTIND - 1))

command -v aws >/dev/null || die "aws cli not found"
command -v jq  >/dev/null || die "jq not found"

# --- session details -------------------------------------------------------
# `aws configure get` cannot read [sso-session] blocks, so parse the ini directly.
AWS_CONFIG=${AWS_CONFIG_FILE:-$HOME/.aws/config}
ini_get() { # ini_get <section> <key>
  awk -v sect="[$1]" -v key="$2" '
    /^[[:space:]]*\[/ { in_sect = ($0 ~ "^[[:space:]]*\\" sect "[[:space:]]*$"); next }
    in_sect {
      line = $0
      sub(/[#;].*/, "", line)
      if (line ~ "^[[:space:]]*" key "[[:space:]]*=") {
        sub("^[[:space:]]*" key "[[:space:]]*=[[:space:]]*", "", line)
        sub(/[[:space:]]+$/, "", line)
        print line; exit
      }
    }' "$AWS_CONFIG" 2>/dev/null
}

sso_sessions() {
  awk '/^[[:space:]]*\[sso-session[[:space:]]+/ {
         s = $0
         sub(/^[[:space:]]*\[sso-session[[:space:]]+/, "", s); sub(/[[:space:]]*\].*$/, "", s)
         print s
       }' "$AWS_CONFIG" 2>/dev/null
}

if [ -z "$SESSION" ]; then
  sessions=$(sso_sessions)
  case $(printf '%s' "$sessions" | grep -c .) in
    0) die "no [sso-session] in $AWS_CONFIG (run: aws configure sso-session)" ;;
    1) SESSION=$sessions ;;
    *) die "several sso-sessions, pick one with -s or AWS_SSO_SESSION: $(echo $sessions)" ;;
  esac
fi

START_URL=$(ini_get "sso-session ${SESSION}" sso_start_url)
SSO_REGION=$(ini_get "sso-session ${SESSION}" sso_region)
[ -n "$START_URL" ]  || die "no sso-session '$SESSION' in $AWS_CONFIG (run: aws configure sso-session)"
[ -n "$SSO_REGION" ] || die "sso-session '$SESSION' has no sso_region"

[ -n "$PREFIX_SET" ] || PREFIX=$SESSION
[ -n "$REGION" ] || REGION=$(ini_get default region)
[ -n "$REGION" ] || REGION=$SSO_REGION

# <prefix>-<account>-<role>, or <account>-<role> when the prefix is empty
profile_name() { printf '%s%s-%s' "${PREFIX:+$PREFIX-}" "$(slug "$1")" "$(role_alias "$2")"; }

# --- access token ----------------------------------------------------------
# The token lives in ~/.aws/sso/cache/<sha1>.json keyed by start url.
cached_token() {
  local f
  for f in "$HOME"/.aws/sso/cache/*.json; do
    [ -f "$f" ] || continue
    jq -r --arg u "$START_URL" \
      'select(.accessToken) | select((.startUrl // "") == $u) | .accessToken' "$f" 2>/dev/null
  done | head -1
}

TOKEN=$(cached_token || true)
list_accounts() {
  aws sso list-accounts --access-token "$1" --region "$SSO_REGION" \
    --output json 2>/dev/null
}

ACCOUNTS_JSON=
if [ -n "$TOKEN" ]; then
  ACCOUNTS_JSON=$(list_accounts "$TOKEN" || true)
fi
if [ -z "$ACCOUNTS_JSON" ]; then
  say "==> logging in to SSO session '$SESSION'"
  aws sso login --sso-session "$SESSION"
  TOKEN=$(cached_token || true)
  [ -n "$TOKEN" ] || die "no access token in ~/.aws/sso/cache for $START_URL"
  ACCOUNTS_JSON=$(list_accounts "$TOKEN") || die "sso list-accounts failed"
fi

# --- naming ----------------------------------------------------------------
slug() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//'
}

role_alias() {
  case $1 in
    AdministratorAccess) printf 'admin' ;;
    PowerUserAccess)     printf 'poweruser' ;;
    ReadOnlyAccess)      printf 'readonly' ;;
    ViewOnlyAccess)      printf 'viewonly' ;;
    *) slug "$(printf '%s' "$1" | sed 's/Access$//')" ;;
  esac
}

# --- build the account/role candidate list ---------------------------------
# Each entry: accountId <TAB> accountName <TAB> roleName
say "==> listing accounts and roles"
CANDIDATES=()
while IFS=$'\t' read -r acct_id acct_name; do
  [ -n "$acct_id" ] || continue
  roles=$(aws sso list-account-roles --access-token "$TOKEN" --region "$SSO_REGION" \
            --account-id "$acct_id" --output json | jq -r '.roleList[].roleName' | sort)
  for role in $roles; do
    [ -z "$ROLE_FILTER" ] || [ "$role" = "$ROLE_FILTER" ] || continue
    CANDIDATES+=("${acct_id}"$'\t'"${acct_name}"$'\t'"${role}")
  done
done < <(printf '%s' "$ACCOUNTS_JSON" | jq -r '.accountList[] | "\(.accountId)\t\(.accountName)"' | sort -t$'\t' -k2)

[ ${#CANDIDATES[@]} -gt 0 ] || die "no account/role pairs found${ROLE_FILTER:+ for role $ROLE_FILTER}"

# --- select ----------------------------------------------------------------
SELECTED=()

if [ $# -gt 0 ]; then
  for want in "$@"; do
    want_slug=$(slug "$want")
    found=0
    for entry in "${CANDIDATES[@]}"; do
      IFS=$'\t' read -r id name role <<<"$entry"
      if [ "$want" = "$id" ] || [ "$want_slug" = "$(slug "$name")" ]; then
        SELECTED+=("$entry"); found=1
      fi
    done
    [ $found -eq 1 ] || say "warning: no account matched '$want'"
  done
  [ ${#SELECTED[@]} -gt 0 ] || die "nothing matched"
elif [ $ALL -eq 1 ]; then
  SELECTED=("${CANDIDATES[@]}")
else
  i=0
  for entry in "${CANDIDATES[@]}"; do
    IFS=$'\t' read -r id name role <<<"$entry"
    i=$((i + 1))
    printf '%3d) %-34s %s  ->  %s\n' \
      "$i" "$name" "$id" "$(profile_name "$name" "$role")" >&2
  done
  printf '\nselect (e.g. "1 3 5-7", "all", empty to cancel): ' >&2
  # Prefer the terminal so the menu still works when stdin is a pipe, but fall
  # back to stdin when there is no controlling tty (cron, CI, `echo ... |`).
  if { exec 3</dev/tty; } 2>/dev/null; then
    read -r reply <&3 || true
    exec 3<&-
  else
    read -r reply || true
  fi
  [ -n "${reply// /}" ] || die "cancelled"
  if [ "$reply" = "all" ]; then
    SELECTED=("${CANDIDATES[@]}")
  else
    for tok in $reply; do
      case $tok in
        *-*) lo=${tok%%-*}; hi=${tok##*-} ;;
        *)   lo=$tok; hi=$tok ;;
      esac
      case $lo$hi in *[!0-9]*) die "bad selection: $tok" ;; esac
      n=$lo
      while [ "$n" -le "$hi" ]; do
        [ "$n" -ge 1 ] && [ "$n" -le ${#CANDIDATES[@]} ] || die "out of range: $n"
        SELECTED+=("${CANDIDATES[$((n - 1))]}")
        n=$((n + 1))
      done
    done
  fi
fi

# --- write -----------------------------------------------------------------
created=()
for entry in "${SELECTED[@]}"; do
  IFS=$'\t' read -r id name role <<<"$entry"
  profile=$(profile_name "$name" "$role")

  existing=$(aws configure get sso_account_id --profile "$profile" 2>/dev/null || true)
  if [ -n "$existing" ] && [ $FORCE -eq 0 ]; then
    say "  skip   $profile (exists, account $existing) — use -f to overwrite"
    continue
  fi

  if [ $DRYRUN -eq 1 ]; then
    printf '\n[profile %s]\nsso_session = %s\nsso_account_id = %s\nsso_role_name = %s\nregion = %s\noutput = %s\n' \
      "$profile" "$SESSION" "$id" "$role" "$REGION" "$OUTPUT"
    continue
  fi

  aws configure set --profile "$profile" sso_session    "$SESSION"
  aws configure set --profile "$profile" sso_account_id "$id"
  aws configure set --profile "$profile" sso_role_name  "$role"
  aws configure set --profile "$profile" region         "$REGION"
  aws configure set --profile "$profile" output         "$OUTPUT"
  say "  write  $profile  ($name / $role)"
  created+=("$profile")
done

# --- shell aliases ---------------------------------------------------------
# Only when an alias file was asked for (-A / AWS_SSO_ALIAS_FILE). Rebuilt from
# every SSO profile in the config (any session, any prefix), so the file always
# matches the config regardless of which profiles this run wrote or skipped.
sso_profiles() {
  awk '
    /^[[:space:]]*\[/ {
      name = ""
      if ($0 ~ /^[[:space:]]*\[default\]/) name = "default"
      else if ($0 ~ /^[[:space:]]*\[profile[[:space:]]+/) {
        name = $0
        sub(/^[[:space:]]*\[profile[[:space:]]+/, "", name); sub(/[[:space:]]*\].*$/, "", name)
      }
      next
    }
    name != "" && /^[[:space:]]*(sso_session|sso_start_url)[[:space:]]*=/ { print name; name = "" }
  ' "$AWS_CONFIG" | sort -u
}

# Prefer the aws-sso shipped next to this script; fall back to PATH.
AWS_SSO_BIN=$(cd "$(dirname "$0")" && pwd)/aws-sso
[ -x "$AWS_SSO_BIN" ] || AWS_SSO_BIN=aws-sso

alias_lines() {
  local p
  cat <<EOS
# Generated by ${0##*/} — do not edit; re-run it to update.
# Source this from your shell rc (bash or zsh).

# Switch to an SSO profile: log in only if needed, then export AWS_PROFILE.
# No keys go into the environment; the AWS CLI/SDKs resolve them per call.
aws_use() {
    unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN \\
          AWS_CREDENTIAL_EXPIRATION AWS_PROFILE AWS_DEFAULT_PROFILE \\
          AWS_REGION AWS_DEFAULT_REGION
    '$AWS_SSO_BIN' "\$1" && export AWS_PROFILE="\$1"
}

EOS
  sso_profiles | while read -r p; do
    printf "alias aws-credentials-%s='aws_use %s'\n" "$p" "$p"
  done
}

if [ -z "$ALIAS_FILE" ]; then
  :
elif [ $DRYRUN -eq 1 ]; then
  say ""
  say "==> aliases (dry run, existing profiles only; not written to $ALIAS_FILE)"
  alias_lines | grep '^alias' >&2 || true
else
  mkdir -p "$(dirname "$ALIAS_FILE")"
  tmp=$(mktemp "${ALIAS_FILE}.XXXXXX")
  alias_lines >"$tmp"
  mv "$tmp" "$ALIAS_FILE"
  say "  alias  $(grep -c '^alias' "$ALIAS_FILE") aliases -> $ALIAS_FILE"
fi

if [ $DRYRUN -eq 0 ] && [ ${#created[@]} -gt 0 ]; then
  say ""
  if [ -n "$ALIAS_FILE" ]; then
    say "done. open a new shell (or: source $ALIAS_FILE), then try:"
    for p in "${created[@]}"; do say "  aws-credentials-$p && aws sts get-caller-identity"; done
  else
    say "done. try:"
    for p in "${created[@]}"; do say "  aws-sso $p && AWS_PROFILE=$p aws sts get-caller-identity"; done
  fi
fi
