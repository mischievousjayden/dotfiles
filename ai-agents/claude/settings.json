{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-master-write.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-host-installs.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-agent-attribution.sh"
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true
}
